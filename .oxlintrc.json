{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
	"jsPlugins": ["./lint-plugins/ruang.js"],
	"options": {
		"typeAware": true,
		"reportUnusedDisableDirectives": "error"
	},
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "error"
	},
	"rules": {
		"import/no-default-export": "error",
		"import/no-duplicates": "error",
		"typescript/consistent-type-imports": "error",
		"unicorn/filename-case": [
			"error",
			{
				"case": "kebabCase"
			}
		],
		"import/no-relative-parent-imports": "error",
		"import/no-cycle": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-non-null-assertion": "error",
		"typescript/ban-ts-comment": "error",
		"typescript/no-unsafe-argument": "error",
		"typescript/no-unsafe-assignment": "error",
		"typescript/no-unsafe-call": "error",
		"typescript/no-unsafe-member-access": "error",
		"typescript/no-unsafe-return": "error",
		"typescript/switch-exhaustiveness-check": "error",
		"typescript/consistent-type-definitions": ["error", "type"],
		"typescript/no-floating-promises": "error",
		"typescript/no-misused-promises": "error",
		"no-eval": "error",
		"no-new-func": "error",
		"typescript/no-implied-eval": "error",
		"no-console": "error",
		"react/rules-of-hooks": "error",
		"react/exhaustive-deps": "error",
		"react/no-array-index-key": "error",
		"unicorn/no-nested-ternary": "error",
		"no-param-reassign": "error",
		"react/react-in-jsx-scope": "off",
		"ruang/question-key-server-only": "error"
	},
	"overrides": [
		{
			"files": ["src/**"],
			"rules": {
				"ruang/file-header": "error"
			}
		},
		{
			"files": ["*.config.ts", "lint-plugins/**"],
			"rules": {
				"import/no-default-export": "off"
			}
		},
		{
			"files": ["src/routes/**"],
			"rules": {
				"unicorn/filename-case": "off",
				"react/only-export-components": "off"
			}
		}
	],
	"ignorePatterns": ["src/**/*.gen.ts", ".claude/worktrees/**", "mocks/**"]
}
