{
	"name": "ruang-belajar",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "vite build",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "oxlint",
		"format": "oxfmt",
		"check": "oxlint --deny-warnings && oxfmt --check",
		"typecheck": "tsc --noEmit",
		"prepare": "git config core.hooksPath .githooks",
		"lint:probes": "sh scripts/check-lint-rules.sh",
		"ui:add": "sh scripts/ui-add.sh",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"auth:schema": "pnpm dlx auth@1.7.18 generate --config src/server/auth.ts --output src/db/auth-schema.gen.ts --yes && sh scripts/add-gen-header.sh src/db/auth-schema.gen.ts 'better-auth tables (user, session, account, verification), generated by pnpm auth:schema. Never edit. Not here: app tables (src/db/schema.ts).' && oxfmt src/db/auth-schema.gen.ts"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "0.10.14",
		"@tanstack/react-query": "^5.106.1",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.4",
		"arktype": "^2.2.9",
		"better-auth": "^1.7.18",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "^1.69.0",
		"nitro": "3.0.260610-beta",
		"pg": "^8.23.1",
		"radix-ui": "^1.8.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.91.0",
		"@tanstack/devtools-vite": "0.8.6",
		"@types/node": "^22.10.2",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^0.31.11",
		"oxfmt": "^0.76.0",
		"oxlint": "^1.91.0",
		"oxlint-tsgolint": "^7.0.2006",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^5.1.0"
	},
	"packageManager": "pnpm@12.14.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	}
}
