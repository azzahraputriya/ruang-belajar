# Production values for docker-compose.prod.yml. Copy to .env.production, which git ignores.
# Use letters and digits only (openssl rand -hex 24), so the password needs no escaping in DATABASE_URL.
# Postgres keeps the password it saw when the volume was first created. Changing it here later breaks the connection.
POSTGRES_PASSWORD=replace-me
# Same password as above. The host is the compose service name.
DATABASE_URL=postgres://ruang:replace-me@db:5432/ruang
# openssl rand -base64 32. Changing it signs everyone out.
BETTER_AUTH_SECRET=replace-me-with-32-or-more-characters
BETTER_AUTH_URL=https://lms.afiefabd.com
# Where uploads are stored. docker-compose.prod.yml mounts the uploads volume at this path.
UPLOAD_DIR=/app/data/uploads
